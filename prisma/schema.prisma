generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  LECTURER
  SCHOOL_ADMIN
  SUPER_ADMIN
}

enum OtpPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model School {
  id             String       @id @default(uuid())
  name           String       @unique
  acronym        String?
  contactEmail   String?
  phone          String?
  address        String?
  capacity       Int?
  planExpiresAt  DateTime?
  nextPlanId     String?
  status         String       @default("active")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  faculties      Faculty[]
  departments    Department[]
  users          User[]
  courses        Course[]
  contents       Content[]
  announcements  Announcement[]
  subscriptions  Subscription[]
  admissionRequests AdmissionRequest[]
  anonymousMessages AnonymousMessage[]
}

model Faculty {
  id             String       @id @default(uuid())
  name           String
  deanName       String?
  capacityTarget Int?
  status         String       @default("active")
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  departments    Department[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Department {
  id             String       @id @default(uuid())
  name           String
  schoolId       String
  facultyId      String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  faculty        Faculty      @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  users          User[]
  courses        Course[]
  admissionRequests AdmissionRequest[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model User {
  id             String       @id @default(uuid())
  email          String       @unique
  passwordHash   String
  fullName       String
  phoneNumber    String?
  role           Role         @default(STUDENT)
  status         String       @default("active")
  profileImageUrl String?
  matricNumber   String?      @unique
  pushToken      String?
  bio            String?
  title          String?
  certifications Json?
  achievements   Json?

  schoolId       String?
  departmentId   String?
  school         School?      @relation(fields: [schoolId], references: [id])
  department     Department?  @relation(fields: [departmentId], references: [id])
  
  level          String?

  otps           Otp[]
  enrollments    Enrollment[]
  classRepAssignments ClassRepAssignment[]
  taughtCourses  Course[]     @relation("LecturerCourses")
  announcements  Announcement[]
  announcementLikes AnnouncementLike[]
  announcementComments AnnouncementComment[]
  notifications  Notification[]
  payments       Payment[]
  submissions    AssessmentSubmission[]
  admissionRequests AdmissionRequest[]
  tickets        SupportTicket[]
  feedbacks      Feedback[]
  uploadedContents Content[]    @relation("UserContent")
  sentChatMessages ChatMessage[]
  unlocks        UserUnlock[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("users")
}

model Enrollment {
  id             String       @id @default(uuid())
  studentId      String
  courseId       String
  progress       Int          @default(0)
  student        User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course         Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([studentId, courseId])
}

model ClassRepAssignment {
  id             String       @id @default(uuid())
  courseId       String
  studentId      String
  channel        String?
  active         Boolean      @default(true)
  course         Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student        User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Course {
  id             String       @id @default(uuid())
  code           String
  name           String
  unit           Int?
  credits        Int?
  semester       Int?
  level          String?
  status         String       @default("active")
  module         String?

  schoolId       String
  departmentId   String
  school         School       @relation(fields: [schoolId], references: [id])
  department     Department   @relation(fields: [departmentId], references: [id])

  lecturers      User[]       @relation("LecturerCourses")
  enrollments    Enrollment[]
  classReps      ClassRepAssignment[]
  contents       Content[]
  announcements  Announcement[]
  assessments    Assessment[]
  classSessions  ClassSession[]
  chatMessages   ChatMessage[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Otp {
  id         String     @id @default(uuid())
  purpose    OtpPurpose
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?

  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now())

  @@index([userId, purpose])
}

model RevokedToken {
  id        String   @id @default(uuid())
  jti       String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Content {
  id             String       @id @default(uuid())
  title          String
  type           String       // "resource", "past_question"
  fileType       String
  previewUrl     String?
  downloadUrl    String?
  visibility     String       @default("public")
  isPaid         Boolean      @default(true)
  price          Int?         @default(0)
  level          String?
  courseId       String?
  schoolId       String?
  uploaderId     String?
  course         Course?      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  school         School?      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  uploader       User?        @relation("UserContent", fields: [uploaderId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model GlobalSetting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model ChatMessage {
  id          String   @id @default(uuid())
  courseId    String
  senderId    String
  message     String
  isAnonymous Boolean  @default(false)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sender      User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model Announcement {
  id             String       @id @default(uuid())
  title          String
  message        String
  type           String       @default("GENERAL")
  imageUrl       String?
  audienceType   String
  courseId       String?
  schoolId       String?
  authorId       String
  course         Course?      @relation(fields: [courseId], references: [id])
  school         School?      @relation(fields: [schoolId], references: [id])
  author         User         @relation(fields: [authorId], references: [id])
  likes          AnnouncementLike[]
  comments       AnnouncementComment[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model AnnouncementLike {
  id             String       @id @default(uuid())
  announcementId String
  userId         String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([announcementId, userId])
}

model AnnouncementComment {
  id             String       @id @default(uuid())
  announcementId String
  authorId       String
  content        String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  author         User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Notification {
  id             String       @id @default(uuid())
  title          String
  message        String
  type           String
  isRead         Boolean      @default(false)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Subscription {
  id             String       @id @default(uuid())
  planName       String
  price          Int
  status         String       @default("active")
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Payment {
  id             String       @id @default(uuid())
  reference      String       @unique
  amount         Int
  currency       String       @default("NGN")
  status         String       @default("pending")
  itemType       String       // e.g. "past_question" or "subscription"
  itemId         String
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model UserUnlock {
  id             String       @id @default(uuid())
  userId         String
  itemType       String       // "past_question", "course", "resource"
  itemId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([userId, itemType, itemId])
}

model Assessment {
  id             String       @id @default(uuid())
  title          String
  type           String       // "quiz", "assignment"
  description    String?
  dueDate        DateTime?
  courseId       String
  course         Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions    AssessmentSubmission[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model AssessmentSubmission {
  id             String       @id @default(uuid())
  score          Int?
  fileUrl        String?
  assessmentId   String
  userId         String
  assessment     Assessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model ClassSession {
  id             String       @id @default(uuid())
  topic          String
  startTime      DateTime
  endTime        DateTime
  location       String?      // physical room or meeting URL
  type           String       // "virtual", "physical"
  courseId       String
  course         Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model AdmissionRequest {
  id             String       @id @default(uuid())
  status         String       @default("pending") // "pending", "approved", "rejected"
  userId         String
  schoolId       String
  departmentId   String?
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  department     Department?  @relation(fields: [departmentId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model SupportTicket {
  id             String       @id @default(uuid())
  subject        String
  description    String
  status         String       @default("open") // "open", "in_progress", "resolved", "closed"
  priority       String       @default("medium") // "low", "medium", "high", "critical"
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Feedback {
  id             String       @id @default(uuid())
  message        String
  type           String       // "bug", "feature_request", "general"
  isAnonymous    Boolean      @default(false)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model AnonymousMessage {
  id             String       @id @default(uuid())
  message        String
  schoolId       String?
  school         School?      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}
